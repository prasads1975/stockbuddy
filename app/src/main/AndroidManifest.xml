<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No internet permission required for core workflows (NFR-09, NFR-15).
         Only needed if/when API upload or LAN transfer channels are built (out of MVP scope). -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Placeholder — real Chainway UHF/imager permissions depend on the SDK's
         connection method (internal serial/USB bus). Add once SDK docs are reviewed
         (see hardware/ChainwayScannerManager.kt). -->

    <application
        android:name=".StockBuddyApp"
        android:allowBackup="false"
        android:icon="@drawable/stockbuddy_app_icon"
        android:label="@string/app_name"
        android:theme="@style/Theme.StockBuddy"
        android:supportsRtl="true">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.StockBuddy">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
