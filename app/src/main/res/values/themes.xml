<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- MD3 theme with Professional Teal Branding (NFR-10a) -->
    <style name="Theme.StockBuddy" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Core MD3 Colour Palette -->
        <item name="colorPrimary">@color/md_theme_primary</item>
        <item name="colorOnPrimary">@color/md_theme_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_onPrimaryContainer</item>
        <item name="colorSecondary">@color/md_theme_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_theme_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_theme_onSecondaryContainer</item>
        <item name="colorTertiary">@color/md_theme_tertiary</item>
        <item name="colorOnTertiary">@color/md_theme_onTertiary</item>
        <item name="colorTertiaryContainer">@color/md_theme_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/md_theme_onTertiaryContainer</item>

        <!-- Surfaces and Backgrounds -->
        <item name="android:colorBackground">@color/md_theme_background</item>
        <item name="colorOnBackground">@color/md_theme_onBackground</item>
        <item name="colorSurface">@color/md_theme_surface</item>
        <item name="colorOnSurface">@color/md_theme_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_onSurfaceVariant</item>

        <!-- Outlines and Dividers -->
        <item name="colorOutline">@color/md_theme_outline</item>
        <item name="colorOutlineVariant">@color/md_theme_outlineVariant</item>

        <!-- Error States -->
        <item name="colorError">@color/md_theme_error</item>
        <item name="colorOnError">@color/md_theme_onError</item>
        <item name="colorErrorContainer">@color/md_theme_errorContainer</item>
        <item name="colorOnErrorContainer">@color/md_theme_onErrorContainer</item>

        <!-- System UI: Dark app bar for professional appearance -->
        <item name="android:statusBarColor">@color/app_bar_surface</item>
        <item name="android:navigationBarColor">@color/md_theme_background</item>

        <!-- Shape: Rounded but purposeful (16dp for cards, 12dp for smaller components) -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.StockBuddy.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.StockBuddy.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.StockBuddy.Large</item>

        <!-- Typography: Custom type scale for professional hierarchy -->
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.StockBuddy.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.StockBuddy.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.StockBuddy.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.StockBuddy.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.StockBuddy.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.StockBuddy.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.StockBuddy.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.StockBuddy.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.StockBuddy.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.StockBuddy.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.StockBuddy.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.StockBuddy.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.StockBuddy.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.StockBuddy.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.StockBuddy.LabelSmall</item>
    </style>

    <!-- NFR-10c: primary action button — oversized, 56dp minimum, thumb-zone styling -->
    <style name="Widget.StockBuddy.PrimaryActionButton" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <!-- NFR-10f: RFID scan button — prominent, labelled, NOT a bare icon -->
    <style name="Widget.StockBuddy.RfidScanButton" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">56dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="icon">@drawable/ic_rfid</item>
    </style>

    <!-- NFR-10f: Barcode scan affordance — compact inline icon button -->
    <style name="Widget.StockBuddy.BarcodeScanIcon" parent="Widget.Material3.Button.IconButton">
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <!-- ============================================================================
         SHAPE SYSTEM: Consistent corner radius personality
         ============================================================================ -->
    <style name="ShapeAppearance.StockBuddy.Small" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeAppearance.StockBuddy.Medium" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.StockBuddy.Large" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerSize">16dp</item>
    </style>

    <!-- ============================================================================
         TYPOGRAPHY SCALE: Professional hierarchy with custom type sizes
         Uses Roboto for now; will switch to custom Google Font pairing in Section 2
         ============================================================================ -->

    <!-- Display: Scan count scoreboard on Scanning screen -->
    <style name="TextAppearance.StockBuddy.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:textSize">57sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <style name="TextAppearance.StockBuddy.DisplayMedium" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:textSize">45sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.StockBuddy.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textSize">36sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Headline: Screen titles -->
    <style name="TextAppearance.StockBuddy.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.StockBuddy.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.StockBuddy.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Title: Card headings, session names -->
    <style name="TextAppearance.StockBuddy.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.StockBuddy.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.StockBuddy.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Body: Field labels, list content -->
    <style name="TextAppearance.StockBuddy.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingMultiplier">1.5</item>
    </style>

    <style name="TextAppearance.StockBuddy.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingMultiplier">1.5</item>
    </style>

    <style name="TextAppearance.StockBuddy.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingMultiplier">1.5</item>
    </style>

    <!-- Label: Secondary info, timestamps, metadata -->
    <style name="TextAppearance.StockBuddy.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.StockBuddy.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.StockBuddy.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ============================================================================
         COMPONENT-SPECIFIC STYLING: Professional Material Cards
         ============================================================================ -->

    <!-- Elevated card for important content (e.g., session cards) -->
    <style name="Widget.StockBuddy.CardElevated" parent="Widget.Material3.CardView.Elevated">
        <item name="shapeAppearance">@style/ShapeAppearance.StockBuddy.Medium</item>
        <item name="cardElevation">4dp</item>
        <item name="cardCornerRadius">12dp</item>
    </style>

    <!-- Filled card for list items (e.g., Assets, Results) -->
    <style name="Widget.StockBuddy.CardFilled" parent="Widget.Material3.CardView.Filled">
        <item name="shapeAppearance">@style/ShapeAppearance.StockBuddy.Medium</item>
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">12dp</item>
    </style>

    <!-- Outlined card for less prominent content -->
    <style name="Widget.StockBuddy.CardOutlined" parent="Widget.Material3.CardView.Outlined">
        <item name="shapeAppearance">@style/ShapeAppearance.StockBuddy.Medium</item>
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">12dp</item>
    </style>
</resources>
