<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ============================================================================
         PROFESSIONAL TEAL COLOUR PALETTE
         Seed colour: #0D7C7C (Deep Teal)
         Generated from https://m3.material.io/theme-builder

         This colour scheme is designed to:
         - Feel professional and purpose-built (not generic Android)
         - Stand out in bright retail environments (high saturation)
         - Support easy brand swapping when Gigakin brand colours arrive
           (only change: md_theme_primary, md_theme_secondary, md_theme_tertiary)
         ============================================================================ -->

    <!-- PRIMARY: Dark Navy — main brand colour from Figma design -->
    <color name="md_theme_primary">#002440</color>
    <color name="md_theme_onPrimary">#FFFFFF</color>
    <color name="md_theme_primaryContainer">#1b3a57</color>
    <color name="md_theme_onPrimaryContainer">#87a4c6</color>
    <color name="md_theme_primaryFixed">#acc9ed</color>                    <!-- Light blue for progress bar -->

    <!-- SECONDARY: Slate — accent for secondary actions -->
    <color name="md_theme_secondary">#496177</color>
    <color name="md_theme_onSecondary">#FFFFFF</color>
    <color name="md_theme_secondaryContainer">#c9e2fd</color>
    <color name="md_theme_onSecondaryContainer">#4d657b</color>

    <!-- TERTIARY: Brown — accent for differentiation -->
    <color name="md_theme_tertiary">#321f00</color>
    <color name="md_theme_onTertiary">#FFFFFF</color>
    <color name="md_theme_tertiaryContainer">#ffddb0</color>
    <color name="md_theme_onTertiaryContainer">#2D1609</color>

    <!-- NEUTRAL SURFACES: Clean, professional off-white -->
    <color name="md_theme_background">#FAFBFA</color>
    <color name="md_theme_onBackground">#191C1B</color>
    <color name="md_theme_surface">#FAFBFA</color>
    <color name="md_theme_onSurface">#191C1B</color>
    <color name="md_theme_surfaceVariant">#DEE4E3</color>
    <color name="md_theme_onSurfaceVariant">#4F616E</color>
    <color name="md_theme_surfaceContainer">#EEF0EE</color>
    <color name="md_theme_surfaceContainerHighest">#e3e2e5</color>
    <color name="md_theme_surfaceContainerLowest">#FFFFFF</color>
    <color name="surface_container_low">#f4f3f6</color>        <!-- Light container for summary cards -->

    <!-- OUTLINE: For borders and dividers — professional grey -->
    <color name="md_theme_outline">#7F8B87</color>
    <color name="md_theme_outlineVariant">#CFD9D7</color>

    <!-- ERROR: High-contrast red for Missing/error states -->
    <color name="md_theme_error">#BA1A1A</color>
    <color name="md_theme_onError">#FFFFFF</color>
    <color name="md_theme_errorContainer">#FFDAD6</color>
    <color name="md_theme_onErrorContainer">#410002</color>

    <!-- ============================================================================
         SEMANTIC STATUS COLOURS
         Paired with icon/text per NFR-11 — never colour-alone
         ============================================================================ -->
    <color name="status_available">#1B873D</color>    <!-- Green: scanned items in master -->
    <color name="status_missing">#BA1A1A</color>      <!-- Red: master items not scanned -->
    <color name="status_excess">#B8860B</color>        <!-- Amber: scanned items not in master -->

    <!-- ============================================================================
         READER CONNECTION STATUS (FR-81)
         Used in persistent status bar at top of app
         ============================================================================ -->
    <color name="reader_connected">#1B873D</color>           <!-- Green: reader active -->
    <color name="reader_not_connected">#B8860B</color>        <!-- Amber: reader disconnected -->
    <color name="reader_not_available">#79747E</color>        <!-- Grey: emulator mode -->

    <!-- ============================================================================
         APP BAR AND NAVIGATION
         Dark surface for top/bottom navigation chrome
         ============================================================================ -->
    <color name="app_bar_surface">#0F4F4F</color>             <!-- Very dark teal for top bar -->
    <color name="app_bar_on_surface">#FFFFFF</color>          <!-- White text on dark bar -->
    <color name="nav_bar_tint">#0D7C7C</color>                <!-- Teal icons in bottom nav -->

    <!-- ============================================================================
         SCRIM AND OVERLAY
         For modals, bottom sheets, and dimmed backgrounds
         ============================================================================ -->
    <color name="scrim">#000000</color>                       <!-- 32% alpha overlay -->

    <!-- ============================================================================
         HOME SCREEN DESIGN (from Figma)
         ============================================================================ -->
    <color name="home_background">#faf9fc</color>            <!-- Light background -->
    <color name="home_featured_subtitle">#CCFFFFFF</color>   <!-- on-primary @ 80% (white) — subtitle on the navy featured card -->
    <color name="home_tile_background">#f4f3f6</color>       <!-- Tile background -->
    <color name="home_tile_border">#E0E2E5</color>           <!-- Tile border -->
    <color name="home_tile_title">#1a1c1e</color>            <!-- Tile text -->
    <!-- Home tile icon backgrounds (MD3 tokens per home_hub design) -->
    <color name="home_icon_bg_blue">#c9e2fd</color>          <!-- Linking: secondary-container -->
    <color name="home_icon_bg_peach">#ffddb0</color>         <!-- Assets: tertiary-fixed -->
    <color name="home_icon_bg_grey">#e3e2e5</color>          <!-- Reports: surface-variant -->
    <color name="home_icon_bg_outline">#c3c7ce</color>       <!-- Settings: outline-variant -->
    <color name="home_icon_bg_green">#A8D5BA</color>         <!-- (unused on home; kept for bulk linking) -->
    <color name="home_icon_green">#2E7D32</color>            <!-- Bulk Linking icon tint (dark green) -->
    <!-- Home tile icon tints (MD3 on-container tokens per design) -->
    <color name="home_icon_tint_linking">#4d657b</color>     <!-- on-secondary-container -->
    <color name="home_icon_tint_assets">#5e4112</color>      <!-- on-tertiary-fixed-variant -->
    <color name="home_icon_tint_neutral">#43474d</color>     <!-- on-surface-variant (Reports/Settings) -->
    <color name="home_reader_status_bg">#2E7D32</color>      <!-- Green for reader connected -->

</resources>
