<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_container_low" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <!-- Top border stripe -->
    <item android:height="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/md_theme_error" />
            <corners android:bottomLeftRadius="0dp" android:bottomRightRadius="0dp" android:topLeftRadius="12dp" android:topRightRadius="12dp" />
        </shape>
    </item>
</layer-list>
