<?xml version="1.0" encoding="utf-8"?>
<!-- Dynamic domain field (DROPDOWN) for Individual Linking — label above + outlined exposed
     dropdown menu (box + chevron), identical style to the fixed Category field. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:orientation="vertical">

    <TextView
        android:id="@+id/fieldLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:textSize="12sp"
        android:textColor="@color/md_theme_onSurfaceVariant" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/fieldInputLayout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:hintEnabled="false">

        <AutoCompleteTextView
            android:id="@+id/fieldInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
