<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="?attr/selectableItemBackground"
    android:minHeight="48dp">

    <TextView android:id="@+id/tvCode" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="16sp" android:textStyle="bold" tools:text="3 June Morning" />
    <TextView android:id="@+id/tvTimestamp" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="13sp" android:textColor="?attr/colorOutline" tools:text="03 Jun 2026, 11:11" />

</LinearLayout>
