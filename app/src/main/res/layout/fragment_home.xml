<?xml version="1.0" encoding="utf-8"?>
<!-- NFR-10e exception: Home is a navigation hub, not a task screen — 4 equally-weighted
     tiles is the correct pattern here, not a single primary action.
     ConstraintLayout chains ensure predictable tile sizing across screen sizes. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- Row 1: Linking and Inventory tiles, spread evenly -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/tileLinking"
        android:layout_width="0dp"
        android:layout_height="140dp"
        android:layout_margin="8dp"
        android:text="@string/home_linking"
        android:textSize="18sp"
        style="@style/Widget.Material3.Button.TonalButton"
        app:icon="@drawable/ic_add"
        app:iconGravity="textStart"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tileInventory"
        app:layout_constraintHorizontal_chainStyle="spread_inside" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/tileInventory"
        android:layout_width="0dp"
        android:layout_height="140dp"
        android:layout_margin="8dp"
        android:text="@string/home_inventory"
        android:textSize="18sp"
        style="@style/Widget.Material3.Button.TonalButton"
        app:icon="@drawable/ic_rfid"
        app:iconGravity="textStart"
        app:layout_constraintTop_toTopOf="@id/tileLinking"
        app:layout_constraintStart_toEndOf="@id/tileLinking"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Row 2: Assets and Settings tiles, spread evenly -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/tileAssets"
        android:layout_width="0dp"
        android:layout_height="140dp"
        android:layout_margin="8dp"
        android:text="@string/home_assets"
        android:textSize="18sp"
        style="@style/Widget.Material3.Button.TonalButton"
        app:icon="@drawable/ic_download"
        app:iconGravity="textStart"
        app:layout_constraintTop_toBottomOf="@id/tileLinking"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tileSettings"
        app:layout_constraintHorizontal_chainStyle="spread_inside" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/tileSettings"
        android:layout_width="0dp"
        android:layout_height="140dp"
        android:layout_margin="8dp"
        android:text="@string/home_settings"
        android:textSize="18sp"
        style="@style/Widget.Material3.Button.TonalButton"
        app:icon="@drawable/ic_rfid"
        app:iconGravity="textStart"
        app:layout_constraintTop_toBottomOf="@id/tileInventory"
        app:layout_constraintStart_toEndOf="@id/tileAssets"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
