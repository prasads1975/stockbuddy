<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/home_background">

    <!-- Header: Back button + Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        android:background="@color/home_background">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_arrow_back"
            android:scaleType="centerInside"
            android:tint="@color/md_theme_onSurface"
            android:contentDescription="@string/action_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/inventory_start_title"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/md_theme_primary"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Hardware Status Bar -->
    <LinearLayout
        android:id="@+id/readerStatusBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/surface_container_low">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <ImageView
                android:id="@+id/readerStatusIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/sensors_24px"
                android:tint="@color/status_available"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tvReaderStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:textColor="@color/md_theme_onSurfaceVariant"
                android:letterSpacing="0.05"
                android:text="@string/reader_connected" />
        </LinearLayout>

        <!-- Border divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/md_theme_outline" />
    </LinearLayout>

    <!-- Session Identity & Filter Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:baselineAligned="false">

        <!-- Left: Session Code -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/session_code_label"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:textColor="@color/md_theme_onSurfaceVariant"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvSessionCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/md_theme_onSurface"
                tools:text="3 June Morning" />
        </LinearLayout>

        <!-- Right: Category Filter -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:minWidth="140dp"
            android:layout_marginStart="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/category_label"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:textColor="@color/md_theme_onSurfaceVariant"
                android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/spinnerCategoryFilter"
                android:layout_width="match_parent"
                android:layout_height="40dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Tag Counter Card (Pre-scan state showing 0) -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp"
        app:cardBackgroundColor="@color/md_theme_primaryContainer"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:strokeWidth="1dp"
        app:strokeColor="#1b3a5733">

        <!-- Atmospheric background decorations -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Blurred circle (top-right) -->
            <View
                android:layout_width="128dp"
                android:layout_height="128dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="-64dp"
                android:layout_marginEnd="-64dp"
                android:background="@drawable/shape_blur_circle_primary"
                android:alpha="0.1" />

            <!-- Blurred circle (bottom-left) -->
            <View
                android:layout_width="128dp"
                android:layout_height="128dp"
                android:layout_gravity="bottom|start"
                android:layout_marginBottom="-64dp"
                android:layout_marginStart="-64dp"
                android:background="@drawable/shape_blur_circle_secondary"
                android:alpha="0.2" />

            <!-- Main content -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/unique_tags_label"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:textColor="@android:color/white"
                    android:alpha="0.6"
                    android:layout_marginBottom="16dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/tvScanCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="48sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white" />

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/sensors_24px"
                        android:tint="@android:color/white"
                        android:layout_marginStart="12dp"
                        android:contentDescription="@null" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Spacer to push button to bottom -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- START SCANNING Button (Primary action) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStartScanning"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:text="@string/action_start_scanning"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textAllCaps="true"
        app:backgroundTint="@color/status_available"
        app:cornerRadius="16dp"
        app:icon="@drawable/play_arrow_24px"
        app:iconGravity="textStart"
        app:iconPadding="12dp" />

</LinearLayout>
