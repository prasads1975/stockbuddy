<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/legendRequired"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="?attr/colorOutline"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutName"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/field_product_name">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- FR-06 / NFR-10f: Barcode field with compact inline scan icon (not full-size button) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutBarcode"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/field_barcode"
                app:endIconMode="custom"
                app:endIconDrawable="@drawable/ic_barcode"
                app:endIconContentDescription="Scan barcode">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editBarcode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutCategory"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/field_category">
                <AutoCompleteTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutArticleId"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/field_article_id">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editArticleId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- NFR-52: domain-specific fields rendered dynamically here at runtime -->
            <LinearLayout
                android:id="@+id/dynamicFieldsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="4dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutRfid"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/field_rfid">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editRfid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- FR-07/07a / NFR-10f: RFID scan = prominent labelled button, NOT a bare icon -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScanRfid"
                style="@style/Widget.StockBuddy.RfidScanButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/action_scan_rfid" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- NFR-10c/10d: Save Link is the single oversized, thumb-zone-anchored primary action,
         pinned outside the scroll area at the bottom of the screen. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveLink"
        style="@style/Widget.StockBuddy.PrimaryActionButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="@string/action_save_link" />

</LinearLayout>
